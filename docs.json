{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Lawdie",
  "description": "AI-powered legal assistant platform — documentation for attorneys and legal teams.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Dashboard",
          "icon": "layout-dashboard",
          "href": "https://lawdie.co"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "mailto:support@lawdie.co"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "getting-started/introduction",
          "getting-started/quickstart"
        ]
      },
      {
        "group": "Kiwi AI",
        "icon": "message-circle",
        "expanded": true,
        "pages": [
          "agents/overview",
          "agents/matters",
          "agents/templates",
          "agents/legal-research",
          "agents/rule-statement-rera",
          "agents/patent-search",
          "agents/trademark-search",
          "agents/email-agent",
          "agents/calendar-agent",
          "agents/document-drafting",
          "agents/web-search",
          "agents/deep-research",
          "features/chat-assistant",
          "features/document-analysis",
          "features/call-center"
        ]
      },
      {
        "group": "Integrations",
        "icon": "plug",
        "expanded": true,
        "pages": [
          "integrations/google",
          "integrations/microsoft",
          "integrations/slack",
          "integrations/clio"
        ]
      },
      {
        "group": "Troubleshooting",
        "icon": "wrench",
        "pages": [
          "troubleshooting/common-issues"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Go to Lawdie",
      "href": "https://lawdie.co"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/lawdieinc",
      "linkedin": "https://linkedin.com/company/lawdieinc"
    }
  }
}
